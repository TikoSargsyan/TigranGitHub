  "item": [
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Login successful\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const response = pm.response.json();",
              "",
              "pm.test(\"Token exists\", function () {",
              "    pm.expect(response.token).to.be.a(\"string\").and.not.empty;",
              "});",
              "",
              "pm.collectionVariables.set(\"token\", response.token);",
              "",
              "console.log(\"Login token saved to collection variables\");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "nonadmin_user",
              "type": "string"
            },
            {
              "key": "password",
              "value": "11111111",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "url": {
          "raw": "https://qwallity-prod.onrender.com/login/api",
          "protocol": "https",
          "host": [
            "qwallity-prod",
            "onrender",
            "com"
          ],
          "path": [
            "login",
            "api"
          ]
        }
      },
      "response": []
    },
